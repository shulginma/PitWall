{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PitWall: Drive (MinGW)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-mingw-gui/apps/simulator/pitwall_simulator.exe",
      "args": ["--drive"],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "PitWall: build GUI",
      "environment": [{"name": "PATH", "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"}]
    }
  ]
}
